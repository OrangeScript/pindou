{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react-jsx"
  },
  "include": [
    "tests/**/*.ts",
    "src/types/manualEditor.ts",
    "src/utils/fileNaming.ts",
    "src/utils/focusSession.ts",
    "src/utils/pixelation.ts",
    "src/utils/pixelEditingUtils.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
